  "bugs": {
    "url": "https://github.com/Lucas-Romitti/nidolab/issues"
  },
  "homepage": "https://github.com/Lucas-Romitti/nidolab#readme",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "jquery": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "sass": "^1.107.1"
  }
}
