{
  "name": "nidolab",
  "version": "1.0.0",
  "description": "O **Nidolab** é uma aplicação web desenvolvida com o objetivo de facilitar a criação e organização de times para o jogo **Pokémon Champions**.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "sass": "sass assets/scss/main.scss nidolab-theme.css --style=compressed --quiet-deps",
    "sass:watch": "sass assets/scss/main.scss nidolab-theme.css --watch --style=expanded --quiet-deps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucas-Romitti/nidolab.git"
  },
